# Azure AD Configuration
# Copy this file to .env and fill in your Azure AD app values

# Azure AD App (Client) ID - found in Azure Portal > App Registrations > your app > Overview
VITE_AZURE_CLIENT_ID=your_client_id_here

# Authority URL - replace {tenantId} with your tenant ID
VITE_AZURE_AUTHORITY=https://login.microsoftonline.com/{tenantId}

# Redirect URI - should match what's configured in Azure AD
# For development: http://localhost:5173
# For production: your deployed domain
VITE_AZURE_REDIRECT_URI=http://localhost:5173